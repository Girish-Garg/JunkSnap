# JunkSnap tunables: every one with its default. How to change them: docs/config.md.
# Change a value in config/<stage>.env; for every stage, set it in both dev.env and demo.env. Then
# deploy the server with scripts/deploy.py, the web app with scripts/deploy_web.py, and tag a
# release for the APK. Edit this file only to change a code default itself, in the same PR as the
# code and its contracts/README.md row (server, ml) or frontend/.env.example line (frontend).
# Plain KEY=value lines, no quotes, comments on their own line. Public values only: the server and ml
# values go into a Kubernetes ConfigMap, the VITE_ values into the web and Android bundles, so a
# secret never belongs here (scripts/stage_config.py refuses secret-looking names).
# The defaults match the code. scripts/check_config.py (CI) checks them against
# contracts/README.md (Environment variables) and frontend/.env.example.
# A default's form says what a stage file may set: a whole number (20) takes whole numbers, a
# number with a decimal point (0.85, 60.0) takes any plain number, and neither goes below 0. A
# server or ml value above 0 stays above 0 unless its code takes 0. A JSON list takes a JSON list,
# and comma-separated numbers take as many numbers. A bad value stops the deploy before it starts.

# ================= server: api, worker, scores and crawler (contracts/README.md) =================

# --- Rate limits: per hour, each counted per user and per device ---
# Snap photos, Me too included; checked at presign, at POST /reports and again in moderation.
SNAP_PER_HOUR=20
# Answers to POST /reports/{id}/confirm.
CONFIRMATIONS_PER_HOUR=20
# Site and area letters together.
LETTERS_PER_HOUR=5
# Photo reports ("Report this photo").
FLAGS_PER_HOUR=10
# Withdrawals of your own reports.
WITHDRAWALS_PER_HOUR=10
# Community notes.
NOTES_PER_HOUR=10

# --- Site rules ---
# Rejecters must outnumber an unverified site's backers by this many to reject it.
REJECT_MARGIN=3
# People who must say a site is cleared (at least 3).
CLEANED_QUORUM=3
# How many more people must say cleared than say still there.
CLEARED_MARGIN=3
# Metres from the site a voter's GPS may be (the app's VITE_VOTE_RADIUS_M follows it).
VOTE_RADIUS_M=1000
# Metres from the site a photo reporter's GPS may be (VITE_FLAG_RADIUS_M follows it).
FLAG_RADIUS_M=1000
# Distinct people whose reports warn a photo (2 to PHOTO_FLAG_HIDE).
PHOTO_FLAG_WARN=3
# Distinct people whose reports hide a photo (at least 2).
PHOTO_FLAG_HIDE=8
# Fewer people who hide a photo early when they outnumber its backers by PHOTO_FLAG_SURPLUS.
PHOTO_FLAG_HIDE_EARLY=5
# Surplus over the backers that hides a photo early, or removes a site whose every photo is hidden.
PHOTO_FLAG_SURPLUS=5
# Days without a merged report, vote or after-photo before an open site expires.
SITE_TTL_DAYS=90
# Metres within which a photo report merges into a site of its type when the photos look alike (VITE_SITE_MERGE_RADIUS_M follows it).
SITE_MERGE_RADIUS_M=40
# Metres within which a same-type photo report always merges, whatever the photos look like (0 to SITE_MERGE_RADIUS_M).
SITE_SAME_SPOT_M=20
# Metres from an open zone's centre within which a no-bin report joins it.
ZONE_MERGE_RADIUS_M=500
# Metres a long-range target may be from the reporter (VITE_TARGET_MAX_M follows it).
TARGET_MAX_M=500
# Image-embedding cosine at or above which a report matches a nearby site (above 0, at most 1).
MERGE_MIN_COSINE=0.88
# Metres within which OpenStreetMap places become site.insights.near (at most 100).
NEAR_PLACES_RADIUS_M=100
# Metres: no known bin this near sets site.insights.no_bin_within_3km.
BIN_RADIUS_M=3000
# Hours a reporter has to answer a needs_confirmation report.
CONFIRM_TTL_HOURS=24.0

# --- Area scores and lists ---
# Verified reports an area needs before its scores, shares and letters show (VITE_MIN_VERIFIED_REPORTS follows it).
MIN_VERIFIED_REPORTS=10
# Verified overflowing_bin sites an area needs before bin_service_pct counts.
MIN_BIN_SERVICE_SITES=3
# Areas GET /areas/{kind} lists without a limit (at most 200).
AREA_LIST_DEFAULT_LIMIT=50
# Cap on a larger limit (at most 200).
AREA_LIST_MAX_LIMIT=200

# --- Photo checks in moderation ---
# Hours before received_at a photo's captured_at may be.
PHOTO_MAX_AGE_HOURS=72
# Minutes after received_at a photo's captured_at may be.
PHOTO_MAX_AHEAD_MINUTES=5
# Metres within which an earlier photo can make this one a duplicate.
DUPLICATE_RADIUS_M=100
# pHash bits (of 64) within which that earlier photo is a duplicate.
DUPLICATE_MAX_BITS=8
# Metres from the site a cleanup after-photo's GPS may be (VITE_CLEANUP_RADIUS_M follows it).
CLEANUP_NEAR_SITE_M=50
# MB above which an original photo is invalid_image.
PHOTO_MAX_MB=8
# Degrees of margin round the India outline for the inside-India check (about 2 km).
INDIA_BUFFER_DEG=0.02

# --- Uploads and Scan videos ---
# Seconds a presigned photo or video upload URL lasts.
PRESIGN_TTL_SECONDS=300
# MiB a Scan video may be, at presign and on the real video (VITE_SCAN_MAX_BYTES follows it, in bytes).
SCAN_MAX_MB=40
# Seconds a Scan video may last, at most 60 (VITE_SCAN_MAX_DURATION_MS follows it, in ms).
SCAN_MAX_SECONDS=60
# Pixels on a Scan frame's longer side, either orientation.
SCAN_MAX_LONG_SIDE_PX=1280
# Pixels on a Scan frame's shorter side.
SCAN_MAX_SHORT_SIDE_PX=720
# Milliseconds of video per plain frame.
SCAN_FRAME_INTERVAL_MS=1000
# Strongest phone-hinted moments added as frames (0 to 600).
SCAN_MAX_HINT_FRAMES=60
# Milliseconds from its nearest GPS fix past which a frame is dropped.
SCAN_MAX_FIX_GAP_MS=3000
# Metres of interpolated GPS accuracy past which a frame is dropped.
SCAN_MAX_ACCURACY_M=50
# GPS fixes a Scan needs per second of video (above 0, at most 10).
SCAN_MIN_FIXES_PER_SECOND=1.0
# pHash bits within which a frame repeats the last kept frame.
SCAN_DUPLICATE_BITS=5
# pHash bits within which a frame repeats a kept frame less than SCAN_SAME_SPOT_M away.
SCAN_SIMILAR_BITS=20
# Metres apart two frames count as the same spot for SCAN_SIMILAR_BITS.
SCAN_SAME_SPOT_M=10
# Metres within which kept frames merge into one site per type.
SCAN_SPOT_RADIUS_M=20

# --- Queue and worker ---
# The reports queue's visibility timeout; infra sets the queue's own, so change both together.
QUEUE_VISIBILITY_SECONDS=300
# The queue's max receive count as infra sets it; the last receive marks the report needs_review.
QUEUE_MAX_RECEIVE_COUNT=3
# Milliseconds after which a running handler is abandoned (below QUEUE_VISIBILITY_SECONDS).
WORKER_MESSAGE_DEADLINE_MS=240000
# Seconds of SQS long-poll wait per receive (0 to 20).
WORKER_WAIT_SECONDS=20
# Messages per receive, handled at once (1 to 10).
WORKER_BATCH_SIZE=10
# Seconds the worker waits for ml's /internal/verify; keep it equal to ML_WORKER_BUDGET_S.
ML_VERIFY_TIMEOUT_S=60
# Milliseconds one ffmpeg run on a Scan video may take.
FFMPEG_TIMEOUT_MS=60000

# --- AWS and model call timeouts ---
# Milliseconds to connect, for every AWS SDK client.
AWS_CONNECT_TIMEOUT_MS=3000
# Milliseconds per request for DynamoDB, SQS send, Amazon Location and presign.
AWS_QUICK_TIMEOUT_MS=10000
# Milliseconds of idle socket for those clients (under 6000).
AWS_QUICK_IDLE_MS=5000
# Milliseconds per request for S3 clients that move whole objects.
AWS_TRANSFER_TIMEOUT_MS=30000
# Milliseconds of idle socket for those S3 clients (under 6000).
AWS_TRANSFER_IDLE_MS=5000
# Milliseconds per request for Rekognition and the SQS long poll (at least 21000).
AWS_WAIT_TIMEOUT_MS=30000
# Milliseconds per request for the Scan video download.
AWS_STREAM_TIMEOUT_MS=30000
# Milliseconds per request and idle for the Secrets Manager client (under 6000).
SECRET_TIMEOUT_MS=5000
# Milliseconds for one letter or brand-judge model call.
LLM_CALL_TIMEOUT_MS=25000
# Milliseconds for that whole fallback chain (letters must fit CloudFront's 60 s).
LLM_BUDGET_MS=45000
# Milliseconds for one note moderation or analysis call.
NOTE_LLM_CALL_TIMEOUT_MS=15000
# Milliseconds for that whole note fallback chain.
NOTE_LLM_BUDGET_MS=30000

# --- Retries and paging ---
# Tries of a conditional save that lost to a concurrent one.
SAVE_ATTEMPTS=3
# Tries of a rate-limit counter that lost a conditional write.
COUNTER_ATTEMPTS=5
# Milliseconds of random pause, at most, between those tries.
COUNTER_JITTER_MS=25
# BatchGetItem calls for keys DynamoDB left unprocessed.
BATCH_READ_ATTEMPTS=3
# Keys per BatchGetItem call (at most 100).
BATCH_GET_SIZE=100
# Reminders to a model whose answer is not the JSON asked for, before the next model (0 to 5).
LLM_JSON_RETRIES=1
# Sites-table scan pages an area letter reads before it fails.
AREA_LETTER_MAX_PAGES=20
# Note query pages read for one site's community analysis.
NOTES_MAX_PAGES=5
# by-user queries GET /me/reports runs to fill one page.
MY_REPORTS_MAX_ROUNDS=10
# Sites GET /sites?bbox returns at most, newest first.
MAP_MAX_SITES=500
# Degrees each way a GET /sites?bbox may cover (above 0, at most 10).
BBOX_MAX_DEGREES=1.0

# --- Caches ---
# Seconds of Cache-Control max-age on link-preview pages.
SHARE_CACHE_MAX_AGE_SECONDS=300
# Seconds of Cache-Control max-age on /.well-known/assetlinks.json.
ASSETLINKS_CACHE_MAX_AGE_SECONDS=3600
# Seconds of Cache-Control max-age on every blurred public copy.
MEDIA_CACHE_MAX_AGE_SECONDS=86400
# Seconds a browser keeps a CORS preflight (at most 86400).
CORS_MAX_AGE_SECONDS=600
# Seconds the api reuses a user's blocked flag; a new block takes effect within it.
USER_STANDING_CACHE_SECONDS=60

# --- Model limits ---
# Longest model answer for a site letter, in tokens.
LETTER_MAX_TOKENS=1500
# Longest model answer for an area letter, in tokens.
AREA_LETTER_MAX_TOKENS=2000
# Sampling temperature of the letter models (0 to 1).
LETTER_TEMPERATURE=0.0
# Longest brand judge answer, in tokens.
BRAND_JUDGE_MAX_TOKENS=600
# Longest note moderation answer, in tokens.
NOTE_MODERATION_MAX_TOKENS=60
# Longest note analysis answer, in tokens.
NOTE_ANALYSIS_MAX_TOKENS=500
# Minutes: at most one note analysis per site in this window.
NOTE_ANALYSIS_INTERVAL_MINUTES=10

# --- Ward crawls and share pages ---
# Model-passed photos merged into sites in a district before it is queued for a crawl.
CRAWL_ACTIVATE_AFTER=1
# Hours after queueing that a district's expected_by says.
CRAWL_EXPECTED_HOURS=2
# Days between crawls of a district.
CRAWL_INTERVAL_DAYS=30
# Hours before a failed crawl is retried.
CRAWL_RETRY_HOURS=6
# Milliseconds a share page waits for the Android app before it opens the web app.
ANDROID_HANDOFF_WAIT_MS=2000

# ================= ml: the verification service (contracts/README.md, ML_*) =================

# --- Decision gates: each 0 to 1 ---
# Combined probability at or above which a report is verified.
ML_AUTO_VERIFY_MIN=0.85
# Combined probability at or above which it goes to community check (below ML_AUTO_VERIFY_MIN).
ML_COMMUNITY_CHECK_MIN=0.5
# Two signal scores this far apart strongly disagree (above 0).
ML_DISAGREEMENT_GAP=0.5
# YOLO at or above this lifts a judge "no" or an unusable photo to community check.
ML_YOLO_LIFT_MIN=0.5
# Every detector under this, with the judge under the community floor or absent, rejects.
ML_DETECTORS_VETO_MAX=0.2

# --- Fixed-weight combiner (fw-v0) weights: 0 or more ---
# Rekognition labels.
ML_WEIGHT_REKOGNITION_LABELS=0.4
# YOLO.
ML_WEIGHT_YOLO=0.3
# Embedding classifier.
ML_WEIGHT_EMBEDDING_CLASSIFIER=0.3
# Vision judge (above 0).
ML_WEIGHT_VISION_JUDGE=0.6

# --- Signals: each 0 to 1 unless noted ---
# YOLO boxes under this confidence are dropped (meta-v2 was fitted at 0.25).
ML_YOLO_MIN_CONFIDENCE=0.25
# A burning box at or above this is a hazard.
ML_YOLO_HAZARD_MIN=0.5
# Waste boxes at or above this confidence set the pile size.
ML_YOLO_SIZE_BOX_MIN=0.4
# Share of the image under which a pile is small.
ML_YOLO_SIZE_SMALL_MAX=0.10
# Share of the image under which a pile is medium (above the small one).
ML_YOLO_SIZE_MEDIUM_MAX=0.35
# Waste within this many of the bin's longer side is near it (0 to 5).
ML_YOLO_BIN_REACH=0.5
# A bin or waste alone counts this share of its confidence.
ML_YOLO_BIN_ALONE_WEIGHT=0.5
# Embedding head hazard floor.
ML_EMBEDDING_HAZARD_MIN=0.5
# Rekognition label hazard floor.
ML_LABEL_HAZARD_MIN=0.6
# A weak keyword label counts this share of its confidence.
ML_LABEL_WEAK_WEIGHT=0.6
# DetectLabels labels asked for (1 to 1000).
ML_REKOGNITION_MAX_LABELS=50
# DetectLabels minimum confidence (sent as a percent).
ML_REKOGNITION_MIN_CONFIDENCE=0.5

# --- Vision judge ---
# Output tokens (1 to 8192).
ML_JUDGE_MAX_TOKENS=700
# Temperature (0 to 1).
ML_JUDGE_TEMPERATURE=0.0
# Times an invalid answer is asked again before the next model (0 to 3).
ML_JUDGE_INVALID_ANSWER_RETRIES=1
# Readable brands kept at most (0 to 100).
ML_JUDGE_BRANDS_MAX=20
# Judge hazard floor (0 to 1); a burning hazard at the floor sets burning yes.
ML_JUDGE_HAZARD_MIN=0.5

# --- Timing: seconds above 0 and at most 600, attempts 1 to 10 (the first call included) ---
# Seconds the worker waits for /internal/verify; keep it equal to ML_VERIFY_TIMEOUT_S.
ML_WORKER_BUDGET_S=60.0
# Seconds of that the detectors get; the judge gets the rest.
ML_DETECTORS_BUDGET_S=10.0
# Read timeout of every Bedrock model call and OpenAI.
ML_JUDGE_READ_TIMEOUT_S=8.0
# Connect timeout of those calls.
ML_JUDGE_CONNECT_TIMEOUT_S=3.0
# Attempts of those calls; attempts x read must fit the judge's share.
ML_JUDGE_ATTEMPTS=2
# Read timeout for Rekognition, S3 and Secrets Manager.
ML_AWS_READ_TIMEOUT_S=4.0
# Connect timeout for those.
ML_AWS_CONNECT_TIMEOUT_S=2.0
# Attempts for those; attempts x read must fit ML_DETECTORS_BUDGET_S.
ML_AWS_ATTEMPTS=2
# Read timeout of model-file downloads at start.
ML_MODEL_DOWNLOAD_READ_TIMEOUT_S=30.0
# Connect timeout of those downloads.
ML_MODEL_DOWNLOAD_CONNECT_TIMEOUT_S=5.0
# Attempts of those downloads.
ML_MODEL_DOWNLOAD_ATTEMPTS=3

# --- Photo fit before any model sees it ---
# Pixels on the longest side (224 to 8000).
ML_IMAGE_MAX_SIDE_PX=2048
# Bytes the JPEG must stay under (100000 to 3750000, Bedrock's cap).
ML_IMAGE_MAX_BYTES=3500000
# JPEG qualities tried in order, a JSON list (each 1 to 95).
ML_IMAGE_JPEG_QUALITIES=[90,80,70,60,50,40]

# ================= frontend: web app and Android app, baked in at build time (frontend/.env.example) =================
# Mirrors of a server value above follow it unless config/<stage>.env sets the VITE_ one itself.

# --- Site rules (a mirror follows its server value unless config/<stage>.env sets it) ---
# Votes count within this many metres of the site. Follows VOTE_RADIUS_M.
VITE_VOTE_RADIUS_M=1000
# "Report this photo" works within this many metres of the site. Follows FLAG_RADIUS_M.
VITE_FLAG_RADIUS_M=1000
# A cleanup photo must be taken within this many metres of the site. Follows CLEANUP_NEAR_SITE_M.
VITE_CLEANUP_RADIUS_M=50
# Metres past a radius the map's rougher fix may be before an action is blocked (app only).
VITE_DISTANCE_MARGIN_M=100.0
# Metres a long-range pin reaches from the ground (app only, decision 20261011-0400).
VITE_TARGET_GROUND_MAX_M=300.0
# Metres a long-range pin reaches from a rooftop or upper floor. Follows TARGET_MAX_M.
VITE_TARGET_MAX_M=500
# Metres an up-high photo for a site keeps clear of VITE_TARGET_MAX_M (app only).
VITE_TARGET_MARGIN_M=10.0
# Closer than this many metres the pin counts as "right here" (app only).
VITE_TARGET_HERE_M=10.0
# A report joins a site within this many metres of its point. Follows SITE_MERGE_RADIUS_M.
VITE_SITE_MERGE_RADIUS_M=40
# A no-bin report says there is no dustbin within this many metres; also the zone circle on the map.
# Fixed: must stay 1000 to match the server's no-bin zone radius (NoBinZone.ts, not configurable); stage files cannot change it.
VITE_ZONE_RADIUS_M=1000
# Verified reports an area needs before its scores show, when no scores row says so. Follows MIN_VERIFIED_REPORTS.
VITE_MIN_VERIFIED_REPORTS=10

# --- Map ---
# MapLibre style URL for the site map and the long-range target map (OpenFreeMap needs no key).
# The APK allows only tiles.openfreemap.org for the map (connect-src in apps/android-tauri/src-tauri/tauri.conf.json): another host needs that CSP changed too.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Folder of the boundary files under the app's base URL (public/boundaries/).
VITE_BOUNDARIES_PATH=boundaries/
# Pilot city centre as lon,lat: where the map always opens (Jodhpur).
VITE_PILOT_CENTRE=73.02,26.27
# Pilot city extent as minLon,minLat,maxLon,maxLat: one GET /sites over it loads the whole city (keep under 1 by 1 degree).
VITE_PILOT_BOUNDS=72.96,26.22,73.08,26.36
# MapLibre zoom the map opens at (12 shows about 6 km across a phone).
VITE_PILOT_ZOOM=12.0
# Zoom a single site or search result is shown at, at least.
VITE_MAP_SITE_ZOOM=14.0
# Farthest-out zoom.
VITE_MAP_MIN_ZOOM=4.0
# The box the map cannot be panned out of, as minLon,minLat,maxLon,maxLat (India).
VITE_MAP_MAX_BOUNDS=60,4,100,38.5
# Closest zoom (OpenFreeMap tiles stop at 14 and are overzoomed).
VITE_MAP_MAX_ZOOM=18.0
# Zoom the long-range target map opens at (about 400 m across a phone).
VITE_TARGET_MAP_ZOOM=16.0
# Up to this many sites in view, the map and the list say sites are still few here.
VITE_THIN_MAX=2
# Side of one GET /sites query in degrees (the api allows 1; at most 0.99 after rounding).
VITE_SITE_TILE_DEG=0.99
# Queries per side of a view; a wider view loads only its middle (4 x 0.99 = 3.96 degrees).
VITE_SITE_TILES_PER_SIDE=4
# Pixels of plain padding round the points of a fit (Zoom out, a stack of sites).
VITE_MAP_FIT_PADDING_PX=80
# Pixels of padding when a card leaves too little room for the plain padding.
VITE_MAP_FIT_TIGHT_PX=16
# Share of the map's height a fit with a card up must leave free (0 to 1).
VITE_MAP_FIT_MIN_FREE=0.25
# Milliseconds a one-line message over the map stays (for example after a withdrawal).
VITE_MAP_FLASH_MS=4000
# Milliseconds a basemap may load before the map says it is loading (a quick load shows nothing).
VITE_MAP_LOADING_AFTER_MS=600
# Milliseconds a basemap may load before the map says the network is slow.
VITE_MAP_SLOW_AFTER_MS=8000
# Metres within which sites share one pin with a count, at every zoom.
VITE_PIN_STACK_RADIUS_M=20.0
# Pixels on screen within which pins (or their n/10 badges) share one pin at that zoom.
VITE_PIN_STACK_OVERLAP_PX=40

# --- Capture: GPS, Snap and Scan, on-phone hints, camera watchdog ---
# Milliseconds: a fix already older than this when it arrives is refused for a capture.
VITE_CAPTURE_FIX_MAX_AGE_MS=10000
# Milliseconds with only refused fixes before the newest is used anyway.
VITE_STALE_FIX_FALLBACK_MS=15000
# Milliseconds: watchPosition maximumAge while the camera is open (keep under VITE_CAPTURE_FIX_MAX_AGE_MS).
VITE_GPS_MAX_AGE_MS=5000
# Milliseconds: watchPosition timeout (a timeout just keeps waiting).
VITE_GPS_TIMEOUT_MS=30000
# Milliseconds: maximumAge of the one fresh fix a vote or action takes.
VITE_CURRENT_FIX_MAX_AGE_MS=10000
# Milliseconds: timeout of that fresh fix.
VITE_CURRENT_FIX_TIMEOUT_MS=20000
# Milliseconds: maximumAge of the map's "where am I" fix.
VITE_LOCATE_MAX_AGE_MS=60000
# Milliseconds: timeout of the map's "where am I" fix.
VITE_LOCATE_TIMEOUT_MS=10000
# Milliseconds distance rules (vote, cleanup, add a photo) trust the map's fix.
VITE_FRESH_FIX_MS=120000
# Milliseconds a Scan records at most (the scan_session schema allows at most 60000). Follows SCAN_MAX_SECONDS x 1000.
VITE_SCAN_MAX_DURATION_MS=60000
# Bytes a Scan video may reach; recording stops 2 MiB before. Follows SCAN_MAX_MB x 1048576.
VITE_SCAN_MAX_BYTES=41943040
# Scan video bit rate (2.5 Mbit/s makes a full minute about 19 MB).
VITE_SCAN_VIDEO_BITS_PER_SECOND=2500000
# Pixels on a photo's longest side (the api takes photos up to 8 MB).
VITE_PHOTO_MAX_EDGE_PX=2048
# JPEG quality of a photo (0.1 to 1).
VITE_PHOTO_JPEG_QUALITY=0.85
# Milliseconds between on-phone detector runs (250 is about 4 frames a second).
VITE_EDGE_HINT_INTERVAL_MS=250
# Detector score (0 to 1) a Scan frame needs to be sent as a hint.
VITE_SCAN_HINT_MIN_SCORE=0.35
# Detector score (0 to 1) a live box needs to be drawn.
VITE_EDGE_OVERLAY_MIN_SCORE=0.5
# Live boxes drawn at most, strongest first.
VITE_EDGE_OVERLAY_MAX_BOXES=8
# Frames in a row with waste before the hint says "Waste spotted".
VITE_EDGE_SPOTTED_FRAMES=2
# Milliseconds: a warm inference slower than this keeps the app in cloud mode (the edge probe).
VITE_EDGE_WARMUP_BUDGET_MS=150
# GB of device memory below which the app keeps cloud mode.
VITE_EDGE_MIN_MEMORY_GB=2.0
# Milliseconds without a new frame before the camera counts as frozen and reopens.
VITE_CAMERA_STALL_MS=2000
# Milliseconds between camera watchdog checks.
VITE_CAMERA_CHECK_MS=500
# Camera restarts in a row without a frame before Try again shows.
VITE_CAMERA_MAX_RESTARTS=5

# --- Network ---
# Milliseconds before an api call is given up as timed out (a letter drafts for up to 60 s).
VITE_REQUEST_TIMEOUT_MS=75000
# Milliseconds every presigned PUT gets before its size is counted.
VITE_PUT_BASE_TIMEOUT_MS=30000
# Milliseconds a PUT gets per VITE_PUT_CHUNK_BYTES.
VITE_PUT_MS_PER_CHUNK=1000
# Bytes per chunk (51200 at 1000 ms is a weak 400 kbit/s uplink).
VITE_PUT_CHUNK_BYTES=51200
# Milliseconds a PUT gets at most (15 min: a 40 MB video on that uplink needs about 14).
VITE_PUT_MAX_TIMEOUT_MS=900000
# Milliseconds before a send that failed offline is tried again (it also retries when the phone comes online).
VITE_RETRY_OFFLINE_MS=30000
# Milliseconds before a send the api rate-limited (429) is tried again.
VITE_RETRY_RATE_LIMITED_MS=300000
# Milliseconds a send waits after a server error or timeout; doubles each time.
VITE_RETRY_FIRST_MS=30000
# Milliseconds that doubling wait stops growing at.
VITE_RETRY_MAX_MS=600000
# Milliseconds a presigned URL is reused; keep it under the api's PRESIGN_TTL_SECONDS (300 s).
VITE_PRESIGN_REUSE_MS=240000
# Milliseconds of pretend network delay in mock mode.
VITE_MOCK_DELAY_MS=400

# --- Caches and refresh ---
# Milliseconds an area listing is reused as is (the scores CronJob runs every 15 minutes).
VITE_AREA_CACHE_TTL_MS=300000
# Area listings kept.
VITE_AREA_CACHE_ENTRIES=32
# Milliseconds before an open session reads the boundary index again (picks up a new deploy).
VITE_BOUNDARY_INDEX_TTL_MS=600000
# GET /sites?bbox answers kept with their ETags (every read still asks; a 304 keeps the copy).
VITE_SITE_CACHE_TILES=16
# GET /sites/{id} answers kept with their ETags.
VITE_SITE_CACHE_SITES=32
# Milliseconds Activity's list token stays fresh before opening Activity syncs with the api.
VITE_ACTIVITY_TTL_MS=60000
# Milliseconds between syncs while Activity is open.
VITE_ACTIVITY_SYNC_MS=15000
# Milliseconds between reads of a report still being checked.
VITE_REPORT_POLL_MS=4000
# Milliseconds between reads of a Scan still being checked.
VITE_SCAN_POLL_MS=5000
# Milliseconds between reads of a site whose cleanup photo is being checked.
VITE_CLEANUP_POLL_MS=5000
# Milliseconds between reads in the "What we checked" view.
VITE_FEEDBACK_POLL_MS=5000

# --- UI timing ---
# Milliseconds an app toast stays.
VITE_TOAST_MS=4500
# Milliseconds at most a toast with a step (Open app settings, Try again) stays when nobody uses it.
VITE_STEP_TOAST_MS=60000
# Milliseconds the "please confirm your report" toast stays.
VITE_CONFIRM_TOAST_MS=15000
# Milliseconds the "report turned down" toast stays.
VITE_REJECTION_TOAST_MS=12000
# Milliseconds "Link copied" stays.
VITE_COPIED_MS=2500
# Milliseconds an action stays off after the api said 429.
VITE_RATE_LIMIT_COOLDOWN_MS=60000
# Milliseconds between updates of "2 min ago" labels.
VITE_CLOCK_TICK_MS=30000
# Milliseconds an action waits on the saved sign-in or this person's reports before the api's answer decides.
VITE_CHECK_LIMIT_MS=8000
# Milliseconds the splash mark takes to fly into the logo.
VITE_SPLASH_FLY_MS=350
# Milliseconds the still splash shows with reduced motion.
VITE_SPLASH_STILL_MS=450

# --- Limits ---
# Characters a mailto: link may have before the letter goes to the clipboard instead.
VITE_MAILTO_MAX_LENGTH=1800
# Places the map search lists at most.
VITE_SEARCH_RESULTS=6
# Site list rows per page ("Show more" adds a page).
VITE_LIST_PAGE_SIZE=30
