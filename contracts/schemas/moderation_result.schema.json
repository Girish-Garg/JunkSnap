{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Girish-Garg/saboot/main/contracts/schemas/moderation_result.schema.json",
  "title": "moderation_result",
  "description": "Written by the worker for a report photo (rpt_) or a cleanup after-photo (cln_), after the moderation gate, blurring and authenticity checks. Checks run in order and the first failure stops the chain; later checks are skipped. The original goes only to Rekognition.",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_id", "outcome", "reasons", "blurred_key", "blur", "image_moderation", "checks", "phash", "duplicate_of", "note_moderation", "moderated_at"],
  "properties": {
    "report_id": { "type": "string", "pattern": "^(rpt|cln)_[a-z0-9_]{1,40}$", "description": "rpt_ for a report photo, cln_ for a cleanup after-photo." },
    "outcome": { "enum": ["passed", "rejected"] },
    "reasons": {
      "type": "array",
      "description": "Empty when passed. invalid_image: not a decodable JPEG, over 8 MB, or bytes that do not match the client SHA-256.",
      "uniqueItems": true,
      "items": { "enum": ["invalid_image", "unsafe_image", "person_dumping", "outside_india", "stale_timestamp", "duplicate", "rate_limited", "blocked_device", "not_near_site"] }
    },
    "blurred_key": {
      "type": ["string", "null"],
      "pattern": "^media/(reports/rpt|cleanups/cln)_[a-z0-9_]{1,40}\\.jpg$",
      "description": "Key of the blurred copy in the public bucket. Null when rejected before blurring."
    },
    "blur": {
      "description": "Faces and number plates blurred before any public copy exists. Null when rejected before blurring.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["faces", "plates", "provider", "model", "version"],
          "properties": {
            "faces": { "type": "integer", "minimum": 0 },
            "plates": { "type": "integer", "minimum": 0 },
            "provider": { "$ref": "#/$defs/provider" },
            "model": { "type": "string", "description": "Detectors used, for example DetectFaces+DetectText." },
            "version": { "type": "string" }
          }
        }
      ]
    },
    "image_moderation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "labels", "provider", "model", "version"],
      "description": "unsafe_image comes from Rekognition DetectModerationLabels; person_dumping from Rekognition DetectLabels (a Person box overlapping a waste box).",
      "properties": {
        "result": { "enum": ["pass", "fail"] },
        "labels": { "type": "array", "items": { "type": "string" }, "description": "Labels that were flagged; empty when clean." },
        "provider": { "$ref": "#/$defs/provider" },
        "model": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inside_india", "fresh_timestamp", "duplicate", "rate_limit", "device_token"],
      "description": "Limits live in contracts/README.md. near_site is present only for cleanup after-photos.",
      "properties": {
        "inside_india": { "$ref": "#/$defs/check" },
        "fresh_timestamp": { "$ref": "#/$defs/check" },
        "duplicate": { "$ref": "#/$defs/check" },
        "rate_limit": { "$ref": "#/$defs/check" },
        "device_token": { "$ref": "#/$defs/check" },
        "near_site": { "$ref": "#/$defs/check" }
      }
    },
    "phash": { "type": "string", "pattern": "^[0-9a-f]{16}$", "description": "64-bit perceptual hash of the original, hex." },
    "duplicate_of": {
      "type": ["string", "null"],
      "pattern": "^(rpt|cln)_[a-z0-9_]{1,40}$",
      "description": "Earlier photo this one duplicates, or null."
    },
    "note_moderation": {
      "description": "Null when there is no note. A removed note is never shown; the report itself still goes on.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "reasons", "provider", "model", "version"],
          "properties": {
            "result": { "enum": ["clean", "removed"] },
            "reasons": { "type": "array", "uniqueItems": true, "items": { "enum": ["toxic", "personal_data"] } },
            "provider": { "enum": ["bedrock", "comprehend", "junksnap"] },
            "model": { "type": "string" },
            "version": { "type": "string" }
          }
        }
      ]
    },
    "moderated_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "report_id": { "pattern": "^cln_" } } },
      "then": { "properties": { "checks": { "required": ["near_site"] } } }
    }
  ],
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "detail"],
      "properties": {
        "result": { "enum": ["pass", "fail", "skipped"] },
        "detail": { "type": "string", "maxLength": 200, "description": "Short plain reason, never a name or phone number." }
      }
    },
    "provider": { "enum": ["bedrock", "openai", "openrouter", "rekognition", "comprehend", "junksnap"] }
  }
}
