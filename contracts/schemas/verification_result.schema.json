{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Girish-Garg/saboot/main/contracts/schemas/verification_result.schema.json",
  "title": "verification_result",
  "description": "Returned by the agent's POST /internal/verify. p >= auto_verify_min is auto_verified, p >= community_check_min is community_check, lower is rejected. Strong disagreement always gives community_check.",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_id", "probability", "decision", "thresholds", "signals", "features", "judge", "disagreement", "combiner", "decided_at"],
  "properties": {
    "report_id": { "type": "string", "pattern": "^rpt_[a-z0-9_]{1,40}$" },
    "probability": { "type": "number", "minimum": 0, "maximum": 1, "description": "Calibrated probability that the report shows what it claims." },
    "decision": { "enum": ["auto_verified", "community_check", "rejected"] },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auto_verify_min", "community_check_min"],
      "description": "Thresholds used for this decision; defaults 0.85 and 0.5.",
      "properties": {
        "auto_verify_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "community_check_min": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "description": "One entry per model that ran. The vision_judge entry carries the judge's provider, model and version.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "score", "provider", "model", "version", "latency_ms"],
        "properties": {
          "name": { "enum": ["rekognition_labels", "yolo", "embedding_classifier", "vision_judge"] },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "provider": { "enum": ["bedrock", "openai", "openrouter", "rekognition", "comprehend", "junksnap"] },
          "model": { "type": "string" },
          "version": { "type": "string" },
          "latency_ms": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gps_accuracy_m", "reputation", "nearby_verified_reports"],
      "description": "Non-model inputs to the combiner.",
      "properties": {
        "gps_accuracy_m": { "type": "number", "minimum": 0 },
        "reputation": { "type": "number", "minimum": 0, "maximum": 1, "description": "Device reputation; 0.5 for a new device." },
        "nearby_verified_reports": { "type": "integer", "minimum": 0, "description": "Verified reports of the same type within about 40 m, before merging." }
      }
    },
    "judge": {
      "description": "Vision judge verdict; null when the judge did not run. Never used for counts or boxes.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["report_type", "context", "burning", "readable_brands", "rationale"],
          "properties": {
            "report_type": { "enum": ["waste_dump", "no_bin", "contaminated_water", "open_construction", "not_waste"] },
            "context": {
              "enum": ["vacant_plot", "roadside", "drain", "other", "no_bin", "no_pickup", "stagnant", "sewage", "foam", "choked_drain", "uncovered_debris", "dusty_site", null]
            },
            "burning": { "type": "boolean" },
            "readable_brands": { "type": "array", "items": { "type": "string" }, "description": "Brand text the judge could read. A hint for the brand step only." },
            "rationale": { "type": "string", "maxLength": 500 }
          }
        }
      ]
    },
    "disagreement": { "type": "boolean", "description": "True when signals strongly disagree; forces community_check." },
    "combiner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version"],
      "properties": {
        "kind": { "enum": ["fixed_weights", "meta_learner"] },
        "version": { "type": "string" }
      }
    },
    "decided_at": { "type": "string", "format": "date-time" }
  }
}
