{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Girish-Garg/saboot/main/contracts/schemas/verification_result.schema.json",
  "title": "verification_result",
  "description": "Returned by the ml service's POST /internal/verify. The claim is 'this photo shows the reported waste' for purpose report and 'this site is now clean' for purpose cleanup. Report: p >= auto_verify_min is auto_verified, p >= community_check_min is community_check, lower is rejected, and strong disagreement always gives community_check. needs_confirmation (contracts v1.16, report only): the judge was unsure, so the reporter is asked whether they are sure before the report joins a site; the judge's rules can also override the probability (see contracts/README.md). Cleanup: auto_verified (is_clean true) only when p >= auto_verify_min and no disagreement, otherwise rejected; cleanups never go to community check.",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_id", "purpose", "probability", "decision", "is_clean", "thresholds", "signals", "features", "judge", "disagreement", "combiner", "embedding_key", "decided_at"],
  "properties": {
    "report_id": { "type": "string", "pattern": "^(rpt|cln)_[a-z0-9_]{1,40}$", "description": "rpt_ for a report photo, cln_ for a cleanup after-photo." },
    "purpose": { "enum": ["report", "cleanup"] },
    "probability": { "type": "number", "minimum": 0, "maximum": 1, "description": "Calibrated probability that the claim is true." },
    "decision": { "enum": ["auto_verified", "community_check", "rejected", "needs_confirmation"] },
    "is_clean": { "type": ["boolean", "null"], "description": "Cleanup judgement: true when the after-photo shows the site clean. Null for purpose report." },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auto_verify_min", "community_check_min"],
      "description": "Thresholds used for this decision; defaults 0.85 and 0.5.",
      "properties": {
        "auto_verify_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "community_check_min": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "description": "One entry per model that ran; score is support for the claim. The vision_judge entry carries the judge's provider, model and version.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "score", "provider", "model", "version", "latency_ms"],
        "properties": {
          "name": { "enum": ["rekognition_labels", "yolo", "embedding_classifier", "vision_judge"] },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "provider": { "enum": ["bedrock", "openai", "openrouter", "rekognition", "comprehend", "junksnap"] },
          "model": { "type": "string" },
          "version": { "type": "string" },
          "latency_ms": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gps_accuracy_m", "reputation", "nearby_verified_reports"],
      "description": "Non-model inputs to the combiner.",
      "properties": {
        "gps_accuracy_m": { "type": "number", "minimum": 0 },
        "reputation": { "type": "number", "minimum": 0, "maximum": 1, "description": "Reporter reputation: the lower of the user's and the device's; 0.5 for a new user or device." },
        "nearby_verified_reports": { "type": "integer", "minimum": 0, "description": "Verified reports of the same type within about 40 m, before merging; 0 for cleanups." }
      }
    },
    "judge": {
      "description": "Vision judge verdict; null when the judge did not run. Never used for counts or boxes.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["report_type", "context", "burning", "readable_brands", "rationale"],
          "properties": {
            "report_type": { "enum": ["waste_dump", "no_bin", "contaminated_water", "open_construction", "overflowing_bin", "not_waste"] },
            "context": {
              "enum": ["vacant_plot", "roadside", "drain", "other", "no_bin", "no_pickup", "stagnant", "sewage", "foam", "choked_drain", "uncovered_debris", "dusty_site", "overflowing", "damaged", null]
            },
            "burning": { "type": "boolean" },
            "readable_brands": { "type": "array", "items": { "type": "string" }, "description": "Brand text the judge could read. A hint for the brand step only." },
            "rationale": { "type": "string", "maxLength": 500, "description": "The judge's short, neutral reasoning; it names no person." },
            "attributes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["garbage", "bin", "bin_overflowing_or_broken", "water_contamination", "construction_debris", "burning", "photo_usable", "user_verdict", "user_verdict_confidence", "prompt"],
              "description": "Contracts v1.16: the judge's structured answer, each attribute yes, no or uncertain. report_type, context and burning above are derived from it. Optional, so older producers stay valid.",
              "properties": {
                "garbage": { "$ref": "#/$defs/tri_state", "description": "Waste is visible." },
                "bin": { "$ref": "#/$defs/tri_state", "description": "A dustbin or waste container is visible." },
                "bin_overflowing_or_broken": { "$ref": "#/$defs/tri_state" },
                "water_contamination": { "$ref": "#/$defs/tri_state" },
                "construction_debris": { "$ref": "#/$defs/tri_state" },
                "burning": { "$ref": "#/$defs/tri_state" },
                "photo_usable": { "$ref": "#/$defs/tri_state", "description": "The scene can be judged; a dark or night photo whose scene is visible is usable." },
                "user_verdict": { "$ref": "#/$defs/tri_state", "description": "Does the photo support the reporter's claim (for a cleanup: the site is clean)?" },
                "user_verdict_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "prompt": { "type": "string", "description": "Version of the judge prompt, for example judge_v1." }
              }
            }
          }
        }
      ]
    },
    "disagreement": { "type": "boolean", "description": "True when signals strongly disagree; forces community_check." },
    "combiner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version"],
      "properties": {
        "kind": { "enum": ["fixed_weights", "meta_learner"] },
        "version": { "type": "string" }
      }
    },
    "embedding_key": {
      "type": ["string", "null"],
      "pattern": "^embeddings/(rpt|cln)_[a-z0-9_]{1,40}\\.json$",
      "description": "Key of the stored image embedding in the private bucket, for SiteMerger to compare. Null when the embedding signal did not run."
    },
    "decided_at": { "type": "string", "format": "date-time" },
    "insights": {
      "description": "What the waste is, as measured by the models (decision 20261010-0202). Not in required so v1 producers stay valid; ml always sends it. When present it must be an object for purpose report and null for purpose cleanup.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["composition", "size_class", "hazards"],
          "properties": {
            "composition": {
              "type": "array",
              "maxItems": 9,
              "description": "Share of the visible waste per material, largest first, one entry per material. Shares may sum to less than 100; the rest is unknown. Empty when no model estimated it.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["material", "share_pct", "source"],
                "properties": {
                  "material": { "$ref": "#/$defs/material" },
                  "share_pct": { "type": "number", "minimum": 0, "maximum": 100 },
                  "source": { "$ref": "#/$defs/insight_source" }
                }
              }
            },
            "size_class": {
              "description": "Coarse size of the pile; never tonnage. Null when no model estimated it.",
              "anyOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["value", "source"],
                  "properties": {
                    "value": { "$ref": "#/$defs/size_class" },
                    "source": { "$ref": "#/$defs/insight_source" }
                  }
                }
              ]
            },
            "hazards": {
              "type": "array",
              "maxItems": 5,
              "description": "Hazards a model saw, one entry per hazard; empty when none.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["hazard", "confidence", "source"],
                "properties": {
                  "hazard": { "$ref": "#/$defs/hazard" },
                  "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                  "source": { "$ref": "#/$defs/insight_source" }
                }
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "purpose": { "const": "report" } } },
      "then": { "properties": { "is_clean": { "type": "null" }, "report_id": { "pattern": "^rpt_" }, "insights": { "type": "object" } } }
    },
    {
      "if": { "properties": { "purpose": { "const": "cleanup" } } },
      "then": {
        "properties": { "is_clean": { "type": "boolean" }, "decision": { "enum": ["auto_verified", "rejected"] }, "report_id": { "pattern": "^cln_" }, "insights": { "type": "null" } },
        "if": { "properties": { "decision": { "const": "auto_verified" } } },
        "then": { "properties": { "is_clean": { "const": true } } },
        "else": { "properties": { "is_clean": { "const": false } } }
      }
    }
  ],
  "$defs": {
    "tri_state": { "enum": ["yes", "no", "uncertain"] },
    "material": { "enum": ["plastic", "organic", "construction_debris", "paper", "glass", "metal", "textile", "e_waste", "medical"] },
    "size_class": { "enum": ["small", "medium", "large"], "description": "small: fits in a bin bag; medium: up to a handcart; large: needs a truck." },
    "hazard": { "enum": ["burning", "medical_waste", "e_waste", "dead_animal", "chemicals"], "description": "burning covers flame or smoke." },
    "insight_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal", "provider", "model", "version"],
      "description": "The model that produced this estimate.",
      "properties": {
        "signal": { "enum": ["rekognition_labels", "yolo", "embedding_classifier", "vision_judge"] },
        "provider": { "enum": ["bedrock", "openai", "openrouter", "rekognition", "comprehend", "junksnap"] },
        "model": { "type": "string" },
        "version": { "type": "string" }
      }
    }
  }
}
