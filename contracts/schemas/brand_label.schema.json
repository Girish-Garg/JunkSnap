{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Girish-Garg/saboot/main/contracts/schemas/brand_label.schema.json",
  "title": "brand_label",
  "description": "One readable brand on a blurred report photo. The agent's POST /internal/brands returns an array of these, emitting a label only when the text was readable and confidence is at or above the threshold.",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_id", "brand", "parent_company", "confidence", "text_seen", "box", "mapping_source_url", "provider", "model", "version"],
  "properties": {
    "report_id": { "type": "string", "pattern": "^rpt_[a-z0-9_]{1,40}$" },
    "brand": { "type": "string" },
    "parent_company": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "text_seen": { "type": "string", "description": "The text actually read on the packet." },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "width", "height"],
      "description": "Where the text sits, as fractions of image width and height.",
      "properties": {
        "left": { "type": "number", "minimum": 0, "maximum": 1 },
        "top": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "minimum": 0, "maximum": 1 },
        "height": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "mapping_source_url": { "type": "string", "format": "uri", "description": "Public source for the brand-to-parent-company mapping." },
    "provider": { "enum": ["bedrock", "openai", "openrouter", "rekognition", "comprehend", "junksnap"] },
    "model": { "type": "string" },
    "version": { "type": "string" }
  }
}
