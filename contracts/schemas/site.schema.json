{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Girish-Garg/saboot/main/contracts/schemas/site.schema.json",
  "title": "site",
  "description": "One waste site (reports merged within about 40 m, same type) as a GeoJSON Feature with Point geometry, coordinates [lon, lat] in WGS84. GET /sites/{id} returns one; GET /sites?bbox returns a FeatureCollection of them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "geometry", "properties"],
  "properties": {
    "type": { "const": "Feature" },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Point" },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "type": "number", "minimum": -180, "maximum": 180, "description": "lon" },
            { "type": "number", "minimum": -90, "maximum": 90, "description": "lat" }
          ]
        }
      }
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site_id", "report_type", "context", "status", "verification", "report_count", "verified_count", "corroborations", "votes", "photo_urls", "cleanup_status", "cleanup_photo_url", "burning", "location", "brands", "first_reported_at", "last_reported_at", "cleaned_at", "pilot"],
      "properties": {
        "site_id": { "type": "string", "pattern": "^site_[a-z0-9_]{1,40}$", "description": "Kept in properties so MapLibre can promoteId it." },
        "report_type": { "enum": ["waste_dump", "no_bin", "contaminated_water", "open_construction"] },
        "context": { "enum": ["vacant_plot", "roadside", "drain", "other", "no_bin", "no_pickup", "stagnant", "sewage", "foam", "choked_drain", "uncovered_debris", "dusty_site"] },
        "status": { "enum": ["open", "cleaned", "reopened"], "description": "open -> cleaned (only with an after-photo the pipeline confirms) -> reopened." },
        "verification": {
          "enum": ["verified", "community_check", "rejected"],
          "description": "verified once any report is verified; community_check while neighbours are asked to confirm; rejected when votes settle against it (hidden from GET /sites?bbox). Reports on the site follow this value."
        },
        "report_count": { "type": "integer", "minimum": 1 },
        "verified_count": { "type": "integer", "minimum": 0 },
        "corroborations": { "type": "integer", "minimum": 0, "description": "Confirm votes plus Me too reports from other devices." },
        "votes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["confirm", "reject"],
          "properties": {
            "confirm": { "type": "integer", "minimum": 0 },
            "reject": { "type": "integer", "minimum": 0 }
          }
        },
        "photo_urls": {
          "type": "array",
          "maxItems": 6,
          "items": { "type": "string", "format": "uri" },
          "description": "Blurred public copies, newest first. Never an original."
        },
        "cleanup_status": {
          "enum": ["none", "checking", "accepted", "rejected"],
          "description": "Latest cleanup after-photo, for polling after POST /sites/{id}/cleanup. Resets to none when the site reopens."
        },
        "cleanup_photo_url": { "type": ["string", "null"], "format": "uri", "description": "Blurred after-photo of the last accepted cleanup." },
        "burning": { "type": "boolean", "description": "A verified report of this site showed burning; true exactly when insights.hazards lists burning." },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "district", "town", "local_body", "ward", "assembly_seat", "loksabha_seat", "representatives"],
          "description": "The full location_lookup minus lat, lon and provenance. The worker writes it when merging; the api reads it from the sites table, so letters and the site panel need no extra lookup. Ids link to GET /areas/{kind}/{id}/scores.",
          "properties": {
            "state": { "type": "string" },
            "district": { "$ref": "#/$defs/area_ref" },
            "town": { "type": ["string", "null"] },
            "local_body": {
              "description": "Urban local body; its head is a letter's To. Null outside known bodies.",
              "anyOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "name", "head_office"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
                    "name": { "type": "string" },
                    "head_office": { "type": "string" }
                  }
                }
              ]
            },
            "ward": { "anyOf": [{ "$ref": "#/$defs/area_ref" }, { "type": "null" }], "description": "Null where no open ward map exists." },
            "assembly_seat": { "anyOf": [{ "$ref": "#/$defs/area_ref" }, { "type": "null" }], "description": "Null outside Rajasthan, where no assembly boundaries are loaded yet." },
            "loksabha_seat": { "$ref": "#/$defs/loksabha_ref" },
            "representatives": {
              "type": "array",
              "description": "Offices and seats only; no names, no party. No councillor row without a ward, no mla row without an assembly seat.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["office", "seat_id", "as_of", "source"],
                "properties": {
                  "office": { "enum": ["councillor", "mla", "mp"] },
                  "seat_id": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
                  "as_of": { "type": "string", "format": "date" },
                  "source": { "type": "string", "format": "uri" }
                }
              }
            }
          }
        },
        "brands": {
          "type": "array",
          "description": "Only labels that were readable with confidence 0.8 or more.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["brand", "parent_company", "confidence", "source_url"],
            "properties": {
              "brand": { "type": "string" },
              "parent_company": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0.8, "maximum": 1 },
              "source_url": { "type": "string", "format": "uri", "description": "Source for the brand-to-parent-company mapping." }
            }
          }
        },
        "first_reported_at": { "type": "string", "format": "date-time" },
        "last_reported_at": { "type": "string", "format": "date-time" },
        "cleaned_at": { "type": ["string", "null"], "format": "date-time", "description": "Last confirmed cleanup; null if never cleaned." },
        "pilot": { "type": "boolean", "description": "True inside the Jodhpur pilot area." },
        "insights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reports", "composition", "size_class", "hazards", "near"],
          "description": "Merged insights (decision 20261010-0202) of the site's verified reports only, the same reports burning comes from. Recomputed whenever a report on the site becomes verified: by the worker on merge, or by the api when votes settle the site. Not in required so v1 producers stay valid; the worker always writes it.",
          "properties": {
            "reports": { "type": "integer", "minimum": 0, "description": "Verified reports whose verification_result.insights were merged." },
            "composition": {
              "type": "array",
              "maxItems": 9,
              "description": "One entry per material, largest first. share_pct is the mean over the merged reports, a missing material counting as 0.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["material", "share_pct", "reports", "sources"],
                "properties": {
                  "material": { "$ref": "#/$defs/material" },
                  "share_pct": { "type": "number", "minimum": 0, "maximum": 100 },
                  "reports": { "type": "integer", "minimum": 1, "description": "Merged reports that estimated this material." },
                  "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/insight_source" } }
                }
              }
            },
            "size_class": {
              "description": "Most common size class over the merged reports, ties going to the larger; never tonnage. Null when none was estimated.",
              "anyOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["value", "reports", "sources"],
                  "properties": {
                    "value": { "enum": ["small", "medium", "large"] },
                    "reports": { "type": "integer", "minimum": 1 },
                    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/insight_source" } }
                  }
                }
              ]
            },
            "hazards": {
              "type": "array",
              "maxItems": 5,
              "description": "Hazards any merged (verified) report showed; burning here is listed exactly when the burning flag above is true.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["hazard", "reports", "sources"],
                "properties": {
                  "hazard": { "enum": ["burning", "medical_waste", "e_waste", "dead_animal", "chemicals"] },
                  "reports": { "type": "integer", "minimum": 1 },
                  "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/insight_source" } }
                }
              }
            },
            "near": {
              "type": "array",
              "description": "Sensitive places within 100 m, nearest first, from the ward crawler's OpenStreetMap layers (map_layers in data/wards/<city>.json): school, hospital, water (water bodies) and drain (open drains). The worker computes it in the location step. Empty when none or when the city has no crawled layers.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "distance_m", "ref", "source"],
                "properties": {
                  "kind": { "enum": ["school", "hospital", "water", "drain"] },
                  "distance_m": { "type": "number", "minimum": 0, "maximum": 100 },
                  "ref": { "type": "string", "pattern": "^osm:(node|way|relation)/[0-9]+$", "description": "The layer feature's ref, for example osm:way/123." },
                  "source": { "$ref": "#/$defs/layer_source" }
                }
              }
            }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "report_type": { "const": "waste_dump" } } }, "then": { "properties": { "context": { "enum": ["vacant_plot", "roadside", "drain", "other"] } } } },
        { "if": { "properties": { "report_type": { "const": "no_bin" } } }, "then": { "properties": { "context": { "enum": ["no_bin", "no_pickup"] } } } },
        { "if": { "properties": { "report_type": { "const": "contaminated_water" } } }, "then": { "properties": { "context": { "enum": ["stagnant", "sewage", "foam", "choked_drain"] } } } },
        { "if": { "properties": { "report_type": { "const": "open_construction" } } }, "then": { "properties": { "context": { "enum": ["uncovered_debris", "dusty_site"] } } } }
      ]
    }
  },
  "$defs": {
    "area_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
        "name": { "type": "string" }
      }
    },
    "material": { "enum": ["plastic", "organic", "construction_debris", "paper", "glass", "metal", "textile", "e_waste", "medical"] },
    "insight_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal", "provider", "model", "version"],
      "properties": {
        "signal": { "enum": ["rekognition_labels", "yolo", "embedding_classifier", "vision_judge"] },
        "provider": { "enum": ["bedrock", "openai", "openrouter", "rekognition", "comprehend", "junksnap"] },
        "model": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "loksabha_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
        "name": { "type": "string" },
        "status": {
          "enum": ["current", "outdated", null],
          "description": "outdated where the loaded boundary predates a re-delimitation (Assam, Jammu and Kashmir, Ladakh); letters never Cc the MP of an outdated seat. Null when unknown."
        }
      }
    },
    "layer_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "fetched_at", "page_sha256"],
      "description": "The provenance of the map layer the place came from, as the ward crawler writes it.",
      "properties": {
        "source_url": { "type": "string", "pattern": "^https?://" },
        "fetched_at": { "type": "string", "format": "date-time" },
        "page_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
