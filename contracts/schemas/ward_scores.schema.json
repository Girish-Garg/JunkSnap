{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Girish-Garg/saboot/main/contracts/schemas/ward_scores.schema.json",
  "title": "ward_scores",
  "description": "Area scores for a ward, assembly seat, Lok Sabha seat or district, from GET /areas/{kind}/{id}/scores. Area level only. Counts are always present; scores and metrics are null with a reason below min_verified_reports. An area with sites but no score yet returns 200 with zero counts, every score withheld (too_few_reports), null metrics and an empty diagnosis; the worker seeds that row when a site first lands in the area. An area with no sites returns 404 area_not_found. Never invented history.",
  "type": "object",
  "additionalProperties": false,
  "required": ["area", "counts", "min_verified_reports", "scores", "metrics", "diagnosis", "formula_version", "pilot", "data_window", "computed_at"],
  "properties": {
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "name"],
      "properties": {
        "kind": { "enum": ["ward", "assembly", "loksabha", "district"] },
        "id": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
        "name": { "type": "string" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified_reports", "no_bin_reports", "sites", "open_sites", "cleaned_sites", "reopened_sites", "sites_without_bin_within_3km"],
      "properties": {
        "verified_reports": { "type": "integer", "minimum": 0 },
        "no_bin_reports": { "type": "integer", "minimum": 0, "description": "Verified no_bin reports. Shown as a count only; bin access is measured, not taken from these (scores-v2)." },
        "sites": { "type": "integer", "minimum": 0 },
        "open_sites": { "type": "integer", "minimum": 0 },
        "cleaned_sites": { "type": "integer", "minimum": 0 },
        "reopened_sites": { "type": "integer", "minimum": 0 },
        "sites_without_bin_within_3km": { "type": "integer", "minimum": 0, "description": "Verified sites whose site.insights.no_bin_within_3km is true." }
      }
    },
    "min_verified_reports": { "type": "integer", "minimum": 1, "description": "Guardrail; 10 in v1." },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city", "citizen", "bin_access"],
      "description": "0 to 100, higher is better.",
      "properties": {
        "city": { "$ref": "#/$defs/score" },
        "citizen": { "$ref": "#/$defs/score" },
        "bin_access": { "$ref": "#/$defs/score" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["median_days_to_clear", "cleared_within_7_days_pct", "redumped_pct", "no_bin_response_pct", "new_dumps_per_km2_month", "share_vacant_plot_drain_roadside_pct", "median_distance_to_disposal_m", "no_bin_within_3km_pct"],
      "description": "Inputs behind the scores; each null when withheld or not measurable in the data window.",
      "properties": {
        "median_days_to_clear": { "type": ["number", "null"], "minimum": 0 },
        "cleared_within_7_days_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "redumped_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "no_bin_response_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "Share of no_bin sites cleared or served in the window (city score)." },
        "new_dumps_per_km2_month": { "type": ["number", "null"], "minimum": 0 },
        "share_vacant_plot_drain_roadside_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "Share of verified waste_dump reports on vacant plots, drains and roadsides (citizen score)." },
        "median_distance_to_disposal_m": { "type": ["number", "null"], "minimum": 0, "description": "Median of site.insights.nearest_bin.distance_m over verified sites with a known nearest bin (bin access score)." },
        "no_bin_within_3km_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "Share of measured verified sites (no_bin_within_3km not null) with no known bin within 3 km (bin access score)." }
      }
    },
    "diagnosis": {
      "type": "array",
      "uniqueItems": true,
      "description": "Empty when scores are withheld. dumping + no bins = infrastructure_gap; dumping + bins = behaviour; slow clearing = city_response; re-dumping = repeat_spot.",
      "items": { "enum": ["infrastructure_gap", "behaviour", "city_response", "repeat_spot"] }
    },
    "formula_version": { "type": "string", "description": "Matches a formula decision file in docs/decisions/." },
    "pilot": { "type": "boolean" },
    "data_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" }
      }
    },
    "computed_at": { "type": "string", "format": "date-time" },
    "insights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["composition", "hazardous_share_pct", "top_brands", "repeat_spots", "hour_of_day", "day_of_week", "near_school_or_water_count"],
      "description": "Area insights (decision 20261010-0202) over verified reports in data_window and the sites that hold them. Not in required so v1 producers stay valid; scores always writes it. Each value is null with a reason, and reason is null exactly when value is set. Shares and patterns (composition, hazardous_share_pct, hour_of_day, day_of_week) are withheld below min_verified_reports; counts (top_brands, repeat_spots, near_school_or_water_count) always show unless the input is missing (no_data).",
      "properties": {
        "composition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "reports", "sources", "reason"],
          "$ref": "#/$defs/value_reason",
          "properties": {
            "value": {
              "type": ["array", "null"],
              "maxItems": 9,
              "description": "Mean share per material over the reports, largest first; a missing material counts as 0.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["material", "share_pct"],
                "properties": {
                  "material": { "enum": ["plastic", "organic", "construction_debris", "paper", "glass", "metal", "textile", "e_waste", "medical"] },
                  "share_pct": { "type": "number", "minimum": 0, "maximum": 100 }
                }
              }
            },
            "reports": { "type": "integer", "minimum": 0, "description": "Verified reports with a composition estimate." },
            "sources": {
              "type": "array",
              "description": "Each distinct model behind the merged estimates; empty when value is null.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["signal", "provider", "model", "version"],
                "properties": {
                  "signal": { "enum": ["rekognition_labels", "yolo", "embedding_classifier", "vision_judge"] },
                  "provider": { "enum": ["bedrock", "openai", "openrouter", "rekognition", "comprehend", "junksnap"] },
                  "model": { "type": "string" },
                  "version": { "type": "string" }
                }
              }
            },
            "reason": { "$ref": "#/$defs/reason" }
          }
        },
        "hazardous_share_pct": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "hazardous_sites", "sites", "reason"],
          "$ref": "#/$defs/value_reason",
          "properties": {
            "value": { "type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "Share of sites with at least one hazard in site.insights.hazards." },
            "hazardous_sites": { "type": "integer", "minimum": 0 },
            "sites": { "type": "integer", "minimum": 0, "description": "Sites with at least one verified report in the window." },
            "reason": { "$ref": "#/$defs/reason" }
          }
        },
        "top_brands": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "labels", "reason"],
          "$ref": "#/$defs/value_reason",
          "properties": {
            "value": {
              "type": ["array", "null"],
              "maxItems": 5,
              "description": "Most labels first. Only labels readable at confidence 0.8 or more.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["brand", "parent_company", "sites", "labels"],
                "properties": {
                  "brand": { "type": "string" },
                  "parent_company": { "type": "string" },
                  "sites": { "type": "integer", "minimum": 1 },
                  "labels": { "type": "integer", "minimum": 1 }
                }
              }
            },
            "labels": { "type": "integer", "minimum": 0, "description": "All readable labels in the area." },
            "reason": { "$ref": "#/$defs/reason" }
          }
        },
        "repeat_spots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "count", "reason"],
          "$ref": "#/$defs/value_reason",
          "properties": {
            "value": {
              "type": ["array", "null"],
              "maxItems": 10,
              "description": "Site ids of repeat spots, most reports first: sites reopened after a cleanup (these are counts.reopened_sites and the re-dumping behind the repeat_spot diagnosis) plus sites reported on 2 or more IST days.",
              "items": { "type": "string", "pattern": "^site_[a-z0-9_]{1,40}$" }
            },
            "count": { "type": "integer", "minimum": 0, "description": "All repeat spots in the area; at least counts.reopened_sites." },
            "reason": { "$ref": "#/$defs/reason" }
          }
        },
        "hour_of_day": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "reports", "reason"],
          "$ref": "#/$defs/value_reason",
          "properties": {
            "value": { "type": ["array", "null"], "minItems": 24, "maxItems": 24, "items": { "type": "integer", "minimum": 0 }, "description": "Verified reports per hour of captured_at in IST, hour 0 first." },
            "reports": { "type": "integer", "minimum": 0 },
            "reason": { "$ref": "#/$defs/reason" }
          }
        },
        "day_of_week": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "reports", "reason"],
          "$ref": "#/$defs/value_reason",
          "properties": {
            "value": { "type": ["array", "null"], "minItems": 7, "maxItems": 7, "items": { "type": "integer", "minimum": 0 }, "description": "Verified reports per IST weekday, Monday first. no_data while data_window is shorter than 7 days." },
            "reports": { "type": "integer", "minimum": 0 },
            "reason": { "$ref": "#/$defs/reason" }
          }
        },
        "near_school_or_water_count": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "sites", "reason"],
          "$ref": "#/$defs/value_reason",
          "properties": {
            "value": { "type": ["integer", "null"], "minimum": 0, "description": "Sites with a school or water place in site.insights.near. no_data when the city has no crawled map layers." },
            "sites": { "type": "integer", "minimum": 0, "description": "Sites with at least one verified report in the window." },
            "reason": { "$ref": "#/$defs/reason" }
          }
        }
      }
    }
  },
  "$defs": {
    "reason": {
      "enum": [null, "too_few_reports", "no_data"],
      "description": "null when the value is set; too_few_reports below min_verified_reports; no_data when an input is missing."
    },
    "value_reason": {
      "description": "Couples an insight's value and reason: reason is null exactly when value is set (an empty list counts as set).",
      "oneOf": [
        { "properties": { "value": { "not": { "type": "null" } }, "reason": { "const": null } } },
        { "properties": { "value": { "type": "null" }, "reason": { "enum": ["too_few_reports", "no_data"] } } }
      ]
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "reason"],
      "properties": {
        "value": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "reason": {
          "enum": [null, "too_few_reports", "no_data"],
          "description": "null when value is set; too_few_reports below min_verified_reports; no_data when an input is missing, for example disposal points."
        }
      },
      "oneOf": [
        { "properties": { "value": { "type": "number" }, "reason": { "const": null } } },
        { "properties": { "value": { "type": "null" }, "reason": { "enum": ["too_few_reports", "no_data"] } } }
      ]
    }
  }
}
