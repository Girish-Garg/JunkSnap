# Copy to .env.local (or set in the build's environment). Vite bakes every VITE_ variable into the bundle at build
# time, so they are public: never put a secret here. Nothing is fetched at run time; change a value and rebuild.
# Mode defaults to mock unless VITE_API_URL is set.
VITE_API_MODE=mock
VITE_API_URL=
# Live mode sign-in: the stage stack's UserPoolId and UserPoolClientId outputs.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# The stage's public web app for share links, no trailing slash; unset, links use the page's origin.
VITE_WEB_URL=
# Live mode: the host whose /share/* serves the api's link previews, no trailing slash; unset, the api itself.
VITE_SHARE_URL=

# Tunables. Each line shows its default; uncomment one to change it. A value that does not parse, or is out of
# range, is ignored with a console warning and the default is used. src/app/AppConfig.ts reads them all.

# --- Site rules mirrored from the api: change them together with the server variable named in brackets ---
# Votes count within this many metres of the site [VOTE_RADIUS_M].
# VITE_VOTE_RADIUS_M=1000
# "Report this photo" works within this many metres of the site [FLAG_RADIUS_M].
# VITE_FLAG_RADIUS_M=1000
# A cleanup photo must be taken within this many metres of the site [worker near_site check, 50 m].
# VITE_CLEANUP_RADIUS_M=50
# Metres past a radius the map's rougher fix may be before an action is blocked (app only).
# VITE_DISTANCE_MARGIN_M=100
# Metres a long-range pin reaches from the ground (app only, decision 20261011-0400).
# VITE_TARGET_GROUND_MAX_M=300
# Metres a long-range pin reaches from a rooftop or upper floor [TARGET_MAX_M].
# VITE_TARGET_MAX_M=500
# Metres an up-high photo for a site keeps clear of VITE_TARGET_MAX_M (app only).
# VITE_TARGET_MARGIN_M=10
# Closer than this many metres the pin counts as "right here" (app only).
# VITE_TARGET_HERE_M=10
# A report joins a site within this many metres of its point [SITE_MERGE_RADIUS_M].
# VITE_SITE_MERGE_RADIUS_M=40
# A no-bin report says there is no dustbin within this many metres; also the zone circle on the map [ZONE_RADIUS_M].
# VITE_ZONE_RADIUS_M=1000
# Verified reports an area needs before its scores show, when no scores row says so [MIN_VERIFIED_REPORTS].
# VITE_MIN_VERIFIED_REPORTS=10

# --- Map ---
# MapLibre style URL for the site map and the long-range target map (OpenFreeMap needs no key).
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Folder of the boundary files under the app's base URL (public/boundaries/).
# VITE_BOUNDARIES_PATH=boundaries/
# Pilot city centre as lon,lat: where the map always opens (Jodhpur).
# VITE_PILOT_CENTRE=73.02,26.27
# Pilot city extent as minLon,minLat,maxLon,maxLat: one GET /sites over it loads the whole city (keep under 1 by 1 degree).
# VITE_PILOT_BOUNDS=72.96,26.22,73.08,26.36
# MapLibre zoom the map opens at (12 shows about 6 km across a phone).
# VITE_PILOT_ZOOM=12
# Zoom a single site or search result is shown at, at least.
# VITE_MAP_SITE_ZOOM=14
# Farthest-out zoom.
# VITE_MAP_MIN_ZOOM=4
# The box the map cannot be panned out of, as minLon,minLat,maxLon,maxLat (India).
# VITE_MAP_MAX_BOUNDS=60,4,100,38.5
# Closest zoom (OpenFreeMap tiles stop at 14 and are overzoomed).
# VITE_MAP_MAX_ZOOM=18
# Zoom the long-range target map opens at (about 400 m across a phone).
# VITE_TARGET_MAP_ZOOM=16
# Up to this many sites in view, the map and the list say sites are still few here.
# VITE_THIN_MAX=2
# Side of one GET /sites query in degrees (the api allows 1; at most 0.99 after rounding).
# VITE_SITE_TILE_DEG=0.99
# Queries per side of a view; a wider view loads only its middle (4 x 0.99 = 3.96 degrees).
# VITE_SITE_TILES_PER_SIDE=4
# Pixels of plain padding round the points of a fit (Zoom out, a stack of sites).
# VITE_MAP_FIT_PADDING_PX=80
# Pixels of padding when a card leaves too little room for the plain padding.
# VITE_MAP_FIT_TIGHT_PX=16
# Share of the map's height a fit with a card up must leave free (0 to 1).
# VITE_MAP_FIT_MIN_FREE=0.25
# Milliseconds a one-line message over the map stays (for example after a withdrawal).
# VITE_MAP_FLASH_MS=4000
# Milliseconds a basemap may load before the map says it is loading (a quick load shows nothing).
# VITE_MAP_LOADING_AFTER_MS=600
# Milliseconds a basemap may load before the map says the network is slow.
# VITE_MAP_SLOW_AFTER_MS=8000
# Metres within which sites share one pin with a count, at every zoom.
# VITE_PIN_STACK_RADIUS_M=20
# Pixels on screen within which pins (or their n/10 badges) share one pin at that zoom.
# VITE_PIN_STACK_OVERLAP_PX=40

# --- Capture: GPS, Snap and Scan, on-phone hints, camera watchdog ---
# Milliseconds: a fix already older than this when it arrives is refused for a capture.
# VITE_CAPTURE_FIX_MAX_AGE_MS=10000
# Milliseconds with only refused fixes before the newest is used anyway.
# VITE_STALE_FIX_FALLBACK_MS=15000
# Milliseconds: watchPosition maximumAge while the camera is open (keep under VITE_CAPTURE_FIX_MAX_AGE_MS).
# VITE_GPS_MAX_AGE_MS=5000
# Milliseconds: watchPosition timeout (a timeout just keeps waiting).
# VITE_GPS_TIMEOUT_MS=30000
# Milliseconds: maximumAge of the one fresh fix a vote or action takes.
# VITE_CURRENT_FIX_MAX_AGE_MS=10000
# Milliseconds: timeout of that fresh fix.
# VITE_CURRENT_FIX_TIMEOUT_MS=20000
# Milliseconds: maximumAge of the map's "where am I" fix.
# VITE_LOCATE_MAX_AGE_MS=60000
# Milliseconds: timeout of the map's "where am I" fix.
# VITE_LOCATE_TIMEOUT_MS=10000
# Milliseconds distance rules (vote, cleanup, add a photo) trust the map's fix.
# VITE_FRESH_FIX_MS=120000
# Milliseconds a Scan records at most (the scan_session schema allows at most 60000) [scan video limit].
# VITE_SCAN_MAX_DURATION_MS=60000
# Bytes a Scan video may reach; recording stops 2 MiB before [scan video limit, 40 MB].
# VITE_SCAN_MAX_BYTES=41943040
# Scan video bit rate (2.5 Mbit/s makes a full minute about 19 MB).
# VITE_SCAN_VIDEO_BITS_PER_SECOND=2500000
# Pixels on a photo's longest side (the api takes photos up to 8 MB).
# VITE_PHOTO_MAX_EDGE_PX=2048
# JPEG quality of a photo (0.1 to 1).
# VITE_PHOTO_JPEG_QUALITY=0.85
# Milliseconds between on-phone detector runs (250 is about 4 frames a second).
# VITE_EDGE_HINT_INTERVAL_MS=250
# Detector score (0 to 1) a Scan frame needs to be sent as a hint.
# VITE_SCAN_HINT_MIN_SCORE=0.35
# Detector score (0 to 1) a live box needs to be drawn.
# VITE_EDGE_OVERLAY_MIN_SCORE=0.5
# Live boxes drawn at most, strongest first.
# VITE_EDGE_OVERLAY_MAX_BOXES=8
# Frames in a row with waste before the hint says "Waste spotted".
# VITE_EDGE_SPOTTED_FRAMES=2
# Milliseconds: a warm inference slower than this keeps the app in cloud mode (the edge probe).
# VITE_EDGE_WARMUP_BUDGET_MS=150
# GB of device memory below which the app keeps cloud mode.
# VITE_EDGE_MIN_MEMORY_GB=2
# Milliseconds without a new frame before the camera counts as frozen and reopens.
# VITE_CAMERA_STALL_MS=2000
# Milliseconds between camera watchdog checks.
# VITE_CAMERA_CHECK_MS=500
# Camera restarts in a row without a frame before Try again shows.
# VITE_CAMERA_MAX_RESTARTS=5

# --- Network ---
# Milliseconds before an api call is given up as timed out (a letter drafts for up to 60 s).
# VITE_REQUEST_TIMEOUT_MS=75000
# Milliseconds every presigned PUT gets before its size is counted.
# VITE_PUT_BASE_TIMEOUT_MS=30000
# Milliseconds a PUT gets per VITE_PUT_CHUNK_BYTES.
# VITE_PUT_MS_PER_CHUNK=1000
# Bytes per chunk (51200 at 1000 ms is a weak 400 kbit/s uplink).
# VITE_PUT_CHUNK_BYTES=51200
# Milliseconds a PUT gets at most (15 min: a 40 MB video on that uplink needs about 14).
# VITE_PUT_MAX_TIMEOUT_MS=900000
# Milliseconds before a send that failed offline is tried again (it also retries when the phone comes online).
# VITE_RETRY_OFFLINE_MS=30000
# Milliseconds before a send the api rate-limited (429) is tried again.
# VITE_RETRY_RATE_LIMITED_MS=300000
# Milliseconds a send waits after a server error or timeout; doubles each time.
# VITE_RETRY_FIRST_MS=30000
# Milliseconds that doubling wait stops growing at.
# VITE_RETRY_MAX_MS=600000
# Milliseconds a presigned URL is reused; keep it under the api's PRESIGN_TTL_SECONDS (300 s).
# VITE_PRESIGN_REUSE_MS=240000
# Milliseconds of pretend network delay in mock mode.
# VITE_MOCK_DELAY_MS=400

# --- Caches and refresh ---
# Milliseconds an area listing is reused as is (the scores CronJob runs every 15 minutes).
# VITE_AREA_CACHE_TTL_MS=300000
# Area listings kept.
# VITE_AREA_CACHE_ENTRIES=32
# Milliseconds before an open session reads the boundary index again (picks up a new deploy).
# VITE_BOUNDARY_INDEX_TTL_MS=600000
# GET /sites?bbox answers kept with their ETags (every read still asks; a 304 keeps the copy).
# VITE_SITE_CACHE_TILES=16
# GET /sites/{id} answers kept with their ETags.
# VITE_SITE_CACHE_SITES=32
# Milliseconds Activity's list token stays fresh before opening Activity syncs with the api.
# VITE_ACTIVITY_TTL_MS=60000
# Milliseconds between syncs while Activity is open.
# VITE_ACTIVITY_SYNC_MS=15000
# Milliseconds between reads of a report still being checked.
# VITE_REPORT_POLL_MS=4000
# Milliseconds between reads of a Scan still being checked.
# VITE_SCAN_POLL_MS=5000
# Milliseconds between reads of a site whose cleanup photo is being checked.
# VITE_CLEANUP_POLL_MS=5000
# Milliseconds between reads in the "What we checked" view.
# VITE_FEEDBACK_POLL_MS=5000

# --- UI timing ---
# Milliseconds an app toast stays.
# VITE_TOAST_MS=4500
# Milliseconds at most a toast with a step (Open app settings, Try again) stays when nobody uses it.
# VITE_STEP_TOAST_MS=60000
# Milliseconds the "please confirm your report" toast stays.
# VITE_CONFIRM_TOAST_MS=15000
# Milliseconds the "report turned down" toast stays.
# VITE_REJECTION_TOAST_MS=12000
# Milliseconds "Link copied" stays.
# VITE_COPIED_MS=2500
# Milliseconds an action stays off after the api said 429.
# VITE_RATE_LIMIT_COOLDOWN_MS=60000
# Milliseconds between updates of "2 min ago" labels.
# VITE_CLOCK_TICK_MS=30000
# Milliseconds an action waits on the saved sign-in or this person's reports before the api's answer decides.
# VITE_CHECK_LIMIT_MS=8000
# Milliseconds the splash mark takes to fly into the logo.
# VITE_SPLASH_FLY_MS=350
# Milliseconds the still splash shows with reduced motion.
# VITE_SPLASH_STILL_MS=450

# --- Limits ---
# Characters a mailto: link may have before the letter goes to the clipboard instead.
# VITE_MAILTO_MAX_LENGTH=1800
# Places the map search lists at most.
# VITE_SEARCH_RESULTS=6
# Site list rows per page ("Show more" adds a page).
# VITE_LIST_PAGE_SIZE=30
